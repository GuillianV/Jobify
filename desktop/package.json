{
  "name": "jobify-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/fix-electron-macos.mjs",
    "fix-electron": "node scripts/fix-electron-macos.mjs",
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:5173 && node scripts/start-electron.mjs\"",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node scripts/start-electron.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}

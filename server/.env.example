# =====================================================================
# Jobify - connecteurs d'offres d'emploi (marche francais)
# Copier ce fichier en `.env` (ignore par git) puis renseigner les cles.
# Chaque bloc indique OU creer la cle.
# =====================================================================

# --- Serveur ---------------------------------------------------------
PORT=3001
HOST=localhost

# --- France Travail (ex Pole Emploi) - LE SOCLE ----------------------
# Creer un compte + une application, puis souscrire a l'API
# "Offres d'emploi v2" pour obtenir identifiant client + cle secrete.
# Inscription : https://francetravail.io/inscription
# API         : https://francetravail.io/data/api/offres-emploi
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Scope requis (ne pas modifier sauf indication de la doc)
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# --- Adzuna (agregateur, free tier ~1000 appels/mois) ----------------
# Inscription : https://developer.adzuna.com/signup
# Cles ensuite : https://developer.adzuna.com/admin/access_details
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Careerjet (agregateur, modele affiliation) ----------------------
# Compte partenaire : https://www.careerjet.com/partners/
CAREERJET_AFFID=

# --- Groq (dedup semantique des offres par LLM, free tier) -----------
# Cle gratuite immediate (compte requis).
# Inscription : https://console.groq.com/keys
# Sans cle, la dedup exacte reste active (degradation gracieuse).
GROQ_API_KEY=
# Modele par defaut si non precise : llama-3.3-70b-versatile
GROQ_MODEL=
